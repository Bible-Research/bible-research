# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

SECRET_KEY=your-secret-key-here
DEBUG=True
DBT_KEY=
ESV_KEY=

# Database — defaults to local SQLite if unset.
# For remote PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Remote Postgres TLS: same CA PEM as Vercel `capem` or GCP Secret `DB_SSL_CERT`.
# Either name works. Written to /tmp/bible-research-postgres-ca.pem at startup (not repo ca.pem).
# DB_SSL_CERT=
# capem=

# Google Cloud TTS + GCS audio (public config; auth is ADC on GCP)
GOOGLE_TTS_LANGUAGE_CODE=lv-LV
GOOGLE_TTS_VOICE_NAME=lv-LV-Chirp3-HD-Sadachbia
GOOGLE_TTS_SAMPLE_RATE_HERTZ=24000
AUDIO_BUCKET_NAME=bible-research-489314-bible-audio
AUDIO_SIGNED_URL_TTL_SECONDS=3600
MONTHLY_TTS_CHAR_LIMIT=100000
LOCK_STALE_HOURS=24
