# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

SECRET_KEY=your-secret-key-here
DEBUG=True
DBT_KEY=
ESV_KEY=

# Database — defaults to local SQLite if unset.
# For remote PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Remote Postgres TLS: same CA PEM as Vercel `capem` or GCP Secret `DB_SSL_CERT`.
# Either name works. Written to /tmp/bible-research-postgres-ca.pem at startup (not repo ca.pem).
# DB_SSL_CERT=
# capem=
